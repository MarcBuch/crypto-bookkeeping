{
  "name": "bookkeeping-flue",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run workflow:check-repo",
    "workflow:check-repo": "bunx flue run workflow:check-repo --config flue.config.ts --target node --input '{}'",
    "build": "bunx flue build --config flue.config.ts --target node"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@flue/runtime": "^1.0.0-beta.9",
    "hono": "^4.12.27",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@flue/cli": "^1.0.0-beta.9",
    "@types/bun": "^1.3.14"
  }
}
