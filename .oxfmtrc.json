{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": false,
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "options": {
        "sortTailwindcss": true
      }
    }
  ],
  "ignorePatterns": [
    ".opencode/**",
    ".worktrees/**",
    "node_modules/**",
    "dist/**",
    "apps/*/dist/**",
    "packages/*/dist/**",
    "data/**",
    "bun.lock"
  ]
}
