{
  "name": "lp-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "cli": "bun run --filter @lp-tracker/cli start",
    "api": "bun run --filter @lp-tracker/api start",
    "api:dev": "bun run --filter @lp-tracker/api dev",
    "web": "bun run --filter @lp-tracker/web dev",
    "web:build": "bun run --filter @lp-tracker/web build",
    "web:preview": "bun run --filter @lp-tracker/web preview",
    "lint": "oxlint apps packages scripts",
    "lint:fix": "oxlint apps packages scripts --fix",
    "format": "oxfmt apps packages scripts README.md package.json",
    "format:check": "oxfmt --check apps packages scripts README.md package.json",
    "check": "bun run lint && bun run format:check && bun run --filter @lp-tracker/core check && bun run --filter @lp-tracker/web check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "^5.6.0"
  }
}
